# Local secrets — never commit
.env

# nv-aces generated eval results (regenerate locally / via CI; never committed)
**/evals/results/
.nv-aces-verify/

# uv virtualenv — uv.lock IS committed (nSpect/Black Duck scans it), .venv is not
.venv/
__pycache__/
*.py[cod]

# Frontend dependencies are reproducible from the pinned lockfile.
node_modules/

# Public Studio bundles and their provenance/licenses are tracked for Git plugin installs.
