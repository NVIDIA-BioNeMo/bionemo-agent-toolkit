{
  "mcpServers": {
    "rfd4-studio-app": {
      "command": "./atomworks-studio/start_server",
      "args": [
        "app"
      ],
      "cwd": ".",
      "startup_timeout_sec": 120,
      "env_vars": [
        "RFD4_STUDIO_HOME",
        "RFD4_STUDIO_PYTHON",
        "RFD4_EDITOR_URL",
        "RFD4_EDITOR_PYTHON",
        "NGS_WORKBENCH_MCP_ROOT",
        "NGS_ANALYSIS_WORKBENCH_STATE_DIR",
        "CODEX_HOME"
      ],
      "default_tools_approval_mode": "auto"
    },
    "rfd4-studio": {
      "command": "./atomworks-studio/start_server",
      "args": [
        "agent"
      ],
      "cwd": ".",
      "startup_timeout_sec": 120,
      "env_vars": [
        "RFD4_STUDIO_HOME",
        "RFD4_STUDIO_PYTHON",
        "RFD4_EDITOR_URL",
        "RFD4_EDITOR_PYTHON",
        "NGS_WORKBENCH_MCP_ROOT",
        "NGS_ANALYSIS_WORKBENCH_STATE_DIR",
        "CODEX_HOME"
      ],
      "tools": {
        "execute_rfd4_plan": {
          "approval_mode": "prompt"
        }
      },
      "default_tools_approval_mode": "auto"
    }
  }
}
