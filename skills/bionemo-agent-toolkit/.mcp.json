{
  "mcpServers": {
    "rfd4-studio-app": {
      "command": "./atomworks-studio/start_server",
      "args": [
        "app"
      ],
      "cwd": ".",
      "startup_timeout_sec": 120,
      "env_vars": [
        "RFD4_STUDIO_HOME",
        "RFD4_STUDIO_PYTHON",
        "RFD4_EDITOR_URL",
        "RFD4_EDITOR_PYTHON",
        "CODEX_HOME"
      ],
      "default_tools_approval_mode": "auto"
    },
    "rfd4-studio": {
      "command": "./atomworks-studio/start_server",
      "args": [
        "agent"
      ],
      "cwd": ".",
      "startup_timeout_sec": 120,
      "env_vars": [
        "RFD4_STUDIO_HOME",
        "RFD4_STUDIO_PYTHON",
        "RFD4_EDITOR_URL",
        "RFD4_EDITOR_PYTHON",
        "CODEX_HOME"
      ],
      "tools": {
        "refresh_compute_access": {
          "approval_mode": "prompt"
        },
        "execute_rfd4_plan": {
          "approval_mode": "prompt"
        },
        "recover_queued_rfd4_job": {
          "approval_mode": "prompt"
        },
        "execute_compute_creation": {
          "approval_mode": "prompt"
        },
        "execute_compute_start": {
          "approval_mode": "prompt"
        },
        "execute_compute_stop": {
          "approval_mode": "prompt"
        },
        "execute_runtime_setup": {
          "approval_mode": "prompt"
        }
      },
      "default_tools_approval_mode": "auto"
    }
  }
}
