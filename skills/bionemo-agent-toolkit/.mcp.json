{
  "mcpServers": {
    "rfd4-studio-app": {
      "command": "./atomworks-studio/start_server",
      "args": [
        "app"
      ],
      "cwd": ".",
      "startup_timeout_sec": 120,
      "env_vars": [
        "RFD4_STUDIO_HOME",
        "RFD4_STUDIO_PYTHON",
        "RFD4_EDITOR_URL",
        "RFD4_EDITOR_PYTHON",
        "CODEX_HOME"
      ],
      "default_tools_approval_mode": "auto",
      "tools": {}
    },
    "rfd4-studio": {
      "command": "./atomworks-studio/start_server",
      "args": [
        "agent"
      ],
      "cwd": ".",
      "startup_timeout_sec": 120,
      "env_vars": [
        "RFD4_STUDIO_HOME",
        "RFD4_STUDIO_PYTHON",
        "RFD4_EDITOR_URL",
        "RFD4_EDITOR_PYTHON",
        "CODEX_HOME"
      ],
      "tools": {
        "submit_design_request": {
          "approval_mode": "prompt"
        }
      },
      "default_tools_approval_mode": "auto"
    }
  }
}
